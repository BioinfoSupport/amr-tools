{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
	"required": ["ref","query"],
	"properties": {
		"ref": {
			"type": "string",
			"format": "file-path",
			"exists": true,
			"pattern": "^\\S+\\.(fasta|fa|fna)$",
			"description": "Path to FASTA file containing assembly contigs"
		},

		"query": {
			"type": "string",
			"format": "file-path-pattern",
			"exists": true,
			"pattern": "^\\S+\\.(fasta|fa|fna)$",
			"description": "Path to FASTA file containing reference assembly contigs"
		}

	}
}